<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="28dp">

        <!-- ══════════ 状态条 ══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 连接状态色点 -->
            <View
                android:id="@+id/dotStatus"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:background="@drawable/dot_status" />

            <TextView
                android:id="@+id/tvConn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/conn_idle"
                android:textColor="@color/dim"
                android:textSize="13sp"
                tools:text="已连接 · H303" />

            <TextView
                android:id="@+id/btnProtocol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:text="@string/action_protocol"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="BLE" />
        </LinearLayout>

        <!-- ANT/BLE 异常横幅 -->
        <TextView
            android:id="@+id/tvAntBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/banner_bg"
            android:padding="11dp"
            android:textColor="@color/err"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="缺少 ANT 服务，请改用 BLE 模式"
            tools:visibility="visible" />

        <!-- 数据源诊断（BLE 下显示 RR 单位判定） -->
        <TextView
            android:id="@+id/tvDiag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:textColor="@color/dim"
            android:textSize="10sp"
            android:visibility="gone"
            tools:text="RR 单位：TICK (n=42)"
            tools:visibility="visible" />

        <!-- ══════════ 心率主卡 ══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_hero"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="18dp">

            <!-- 心率数字 + 单位 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvHr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-thin"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.04"
                    android:text="--"
                    android:textColor="@color/accent"
                    android:textSize="104sp"
                    android:textStyle="normal" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/unit_bpm"
                        android:textColor="@color/text"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvAvgHr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/avg_placeholder"
                        android:textColor="@color/dim"
                        android:textSize="12sp"
                        tools:text="均 68" />
                </LinearLayout>
            </LinearLayout>

            <!-- RR 实时曲线 -->
            <com.rrlogger.ui.widget.RrSparklineView
                android:id="@+id/sparkline"
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_marginTop="10dp" />

            <!-- RR 数值 + 会话状态 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvRr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/rr_placeholder"
                    android:textColor="@color/text"
                    android:textSize="17sp"
                    tools:text="1024 ms" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_idle"
                    android:textColor="@color/dim"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="进行中 · REST" />
            </LinearLayout>
        </LinearLayout>

        <!-- ══════════ 统计条 ══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/card"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingVertical="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvBeats"
                    style="@style/StatValue"
                    android:text="0" />

                <TextView
                    style="@style/StatCaption"
                    android:text="@string/cap_beats" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/stroke" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDropped"
                    style="@style/StatValue"
                    android:text="0" />

                <TextView
                    style="@style/StatCaption"
                    android:text="@string/cap_dropped" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/stroke" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDuration"
                    style="@style/StatValue"
                    android:text="--:--" />

                <TextView
                    style="@style/StatCaption"
                    android:text="@string/cap_duration" />
            </LinearLayout>
        </LinearLayout>

        <!-- ══════════ 数据质量提示 ══════════ -->
        <LinearLayout
            android:id="@+id/qualityCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <View
                android:id="@+id/dotQuality"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/dot_status" />

            <TextView
                android:id="@+id/tvQuality"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/quality_idle"
                android:textColor="@color/dim"
                android:textSize="12sp"
                tools:text="数据质量良好 · 丢弃率 0.2%" />
        </LinearLayout>

        <!-- ══════════ 主操作 ══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="2"
                android:text="@string/action_start"
                android:textSize="15sp"
                app:cornerRadius="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStop"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="10dp"
                android:layout_weight="2"
                android:text="@string/action_stop"
                android:textSize="15sp"
                app:cornerRadius="14dp"
                app:strokeColor="@color/stroke" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMark"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1.2"
                android:text="@string/action_mark"
                android:textSize="15sp"
                app:cornerRadius="14dp"
                app:strokeColor="@color/stroke" />
        </LinearLayout>

        <!-- ══════════ 次级操作 ══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConnect"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/action_connect"
                android:textColor="@color/dim"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExport"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/action_export_short"
                android:textColor="@color/dim"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHistory"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/action_history_short"
                android:textColor="@color/dim"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRefreshAnt"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/action_recheck_short"
                android:textColor="@color/dim"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ══════════ 最近 5 拍 ══════════ -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/title_recent" />

        <TextView
            android:id="@+id/tvRecent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:fontFamily="monospace"
            android:lineSpacingExtra="5dp"
            android:padding="14dp"
            android:text="@string/empty_recent"
            android:textColor="@color/text"
            android:textSize="12sp" />

        <!-- 页脚：版本与承诺 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/footer_hint"
            android:textColor="@color/dim"
            android:textSize="10sp" />
    </LinearLayout>
</ScrollView>
