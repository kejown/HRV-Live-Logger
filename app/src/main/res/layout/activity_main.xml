<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ══════════ 标准界面 ══════════ -->
    <ScrollView
        android:id="@+id/mainScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="10dp"
            android:paddingBottom="28dp">

            <!-- 顶部状态条：连接 · 时长 · 诊断 · 设置 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dotStatus"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="@drawable/dot_status" />

                <TextView
                    android:id="@+id/tvConn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/conn_idle"
                    android:textColor="@color/dim"
                    android:textSize="13sp"
                    tools:text="已连接 · H303" />

                <TextView
                    android:id="@+id/tvDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="2dp"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:text="@string/duration_placeholder"
                    android:textColor="@color/text"
                    android:textSize="17sp"
                    tools:text="21:34" />

                <ImageButton
                    android:id="@+id/btnInfo"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_info"
                    android:padding="12dp"
                    android:src="@drawable/ic_info"
                    app:tint="@color/dim" />

                <ImageButton
                    android:id="@+id/btnSettings"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_settings"
                    android:padding="12dp"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/dim" />
            </LinearLayout>

            <!-- ANT/BLE 异常横幅 -->
            <TextView
                android:id="@+id/tvAntBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/banner_bg"
                android:padding="11dp"
                android:textColor="@color/err"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="缺少 ANT 服务，请改用 BLE 模式"
                tools:visibility="visible" />

            <!-- ══════════ 心率主卡 ══════════ -->
            <LinearLayout
                android:id="@+id/heroCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_hero"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="18dp">

                <!-- 心率数字 + 单位 + 均值胶囊 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvHr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-thin"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.04"
                        android:text="@string/hr_placeholder"
                        android:textColor="@color/accent"
                        android:textSize="104sp"
                        android:textStyle="normal" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/unit_bpm"
                            android:textColor="@color/text"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvAvgHr"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_pill"
                            android:paddingHorizontal="9dp"
                            android:paddingVertical="4dp"
                            android:text="@string/avg_placeholder"
                            android:textColor="@color/orange"
                            android:textSize="11sp"
                            tools:text="均 68" />
                    </LinearLayout>
                </LinearLayout>

                <!-- RR 实时曲线 -->
                <com.rrlogger.ui.widget.RrSparklineView
                    android:id="@+id/sparkline"
                    android:layout_width="match_parent"
                    android:layout_height="92dp"
                    android:layout_marginTop="10dp" />

                <!-- RR 数值 + 会话状态 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvRr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/rr_placeholder"
                        android:textColor="@color/text"
                        android:textSize="17sp"
                        tools:text="1024 ms" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_idle"
                        android:textColor="@color/dim"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="进行中 · REST" />
                </LinearLayout>

                <!-- 拍数 / 丢弃（合并成一行） -->
                <TextView
                    android:id="@+id/tvMetrics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/dim"
                    android:textSize="12sp"
                    tools:text="1542 拍 · 丢 3" />

                <!-- 数据质量（呼吸灯标签） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/dotQuality"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/dot_status" />

                    <TextView
                        android:id="@+id/tvQuality"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/quality_idle"
                        android:textColor="@color/dim"
                        android:textSize="11sp"
                        tools:text="数据质量良好 · 丢弃率 0.2%" />
                </LinearLayout>
            </LinearLayout>

            <!-- ══════════ 主操作 ══════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStart"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="2"
                    android:text="@string/action_start"
                    android:textSize="15sp"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStop"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="2"
                    android:text="@string/action_stop"
                    android:textSize="15sp"
                    app:cornerRadius="16dp"
                    app:strokeColor="@color/stroke" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMark"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1.2"
                    android:text="@string/action_mark"
                    android:textSize="15sp"
                    app:cornerRadius="16dp"
                    app:strokeColor="@color/stroke" />
            </LinearLayout>

            <!-- ══════════ 次级操作（触控区 48dp） ══════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConnect"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/action_connect"
                    android:textColor="@color/dim"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExport"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/action_export_short"
                    android:textColor="@color/dim"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHistory"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/action_history_short"
                    android:textColor="@color/dim"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRefreshAnt"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/action_recheck_short"
                    android:textColor="@color/dim"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- ══════════ 最近 10 拍（默认折叠） ══════════ -->
            <TextView
                android:id="@+id/tvRecentHeader"
                style="@style/SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:text="@string/recent_expand"
                tools:text="最近 10 拍　▸" />

            <TextView
                android:id="@+id/tvRecent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card"
                android:fontFamily="monospace"
                android:lineSpacingExtra="5dp"
                android:padding="14dp"
                android:text="@string/empty_recent"
                android:textColor="@color/text"
                android:textSize="12sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- 页脚：版本与承诺 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/footer_hint"
                android:textColor="@color/dim"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>

    <!-- ══════════ 专注模式（全屏） ══════════ -->
    <LinearLayout
        android:id="@+id/focusRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="20dp"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- 顶部小字：时长 · 结束 · 退出 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvFocusDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="@string/duration_placeholder"
                android:textColor="@color/dim"
                android:textSize="15sp"
                tools:text="21:34" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFocusStop"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="64dp"
                android:text="@string/focus_stop"
                android:textColor="@color/err"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExitFocus"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/focus_exit"
                android:textColor="@color/accent"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 居中：巨大心率 + 均值 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFocusHr"
                android:layout_width="match_parent"
                android:gravity="center"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-thin"
                android:includeFontPadding="false"
                android:letterSpacing="-0.04"
                android:maxLines="1"
                android:text="@string/hr_placeholder"
                android:textColor="@color/accent"
                android:textSize="150sp"
                tools:text="72" />

            <TextView
                android:id="@+id/tvFocusAvg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/avg_placeholder"
                android:textColor="@color/orange"
                android:textSize="14sp"
                tools:text="均 68" />
        </LinearLayout>

        <!-- 底部：大号打点圆钮 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFocusMark"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:text="@string/action_mark"
                android:textSize="16sp"
                app:cornerRadius="48dp" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
